# The nightly job (#98), started overnight by pa-nightly.timer: one process holding the data
# root's lock throughout, which runs a capture cycle with calendar reconciliation, then the
# librarian run (its sessions in the librarian's VM, through Incus), then the backup to the USB
# SSD, each recorded in the status; a step that fails doesn't stop the next. It skips if another
# run holds the lock. nightly.sh gives it the instance's configuration. install-schedules.sh
# renders the @…@ names from lib.sh.
[Unit]
Description=PA: the nightly job (capture with reconciliation, the librarian run, the backup)
# The backup drive is wanted, never required: without it the job still runs, and the status
# records the backup that found no repository.
Wants=network-online.target @BACKUP_MOUNT_UNIT@
# A capture cycle under way finishes first, so the night isn't skipped for it; one that starts
# while the job runs skips instead. Incus starts the librarian's VM, and mounts the wiki.
After=network-online.target incus.service @BACKUP_MOUNT_UNIT@ pa-capture.service

[Service]
Type=oneshot
User=@USER@
ExecStart=@DEPLOY@/nightly.sh
# It writes what the capture cycle writes, the wiki and its git directory, the backup repository
# and restic's cache, and /tmp: the run renders the librarian project there and Incus shares it
# into the VM, so /tmp is the host's (no PrivateTmp). It reads the credentials, the vault copy
# and the code without being able to write them. What's missing stays read-only, and the step
# that needs it records the failure.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-@DATA@/inbox -@DATA@/l0 -@DATA@/catalog -@DATA@/state -@DATA@/status -@DATA@/pa.lock
ReadWritePaths=-@DATA@/wiki -@DATA@/wiki.git
ReadWritePaths=-@BACKUP_REPOSITORY@ -@RESTIC_CACHE@
ReadWritePaths=/tmp
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# HTTPS and DNS, and Incus's socket.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
# L0 and the wiki stay readable to the assistant's VM, which reads them as another user.
UMask=0022
Environment=PYTHONDONTWRITEBYTECODE=1

#!/bin/sh
# follow-current SERVER...: runs the explorer's server on the build `current` points at, and
# restarts it on each new build. The server opens its database once at start and never looks
# at `current` again, so without this it would keep showing the build it started on.
#
# LBUG_DIR is the graph directory: builds/<id>/graph.lbdb, and current -> builds/<id>. The
# server gets LBUG_FILE=builds/<id>/graph.lbdb, the build itself, so a publish between reading
# `current` and opening the file can't leave it on a build other than the one followed here.
# FOLLOW_INTERVAL is how often `current` is read, in seconds.
#
# If the server exits on its own, so does this, with its status, for Docker to restart.
set -u

graph=${LBUG_DIR:?LBUG_DIR must be the graph directory}
interval=${FOLLOW_INTERVAL:-2}
server=""
serving=""

stop_server() {
  [ -n "$server" ] || return 0
  kill -TERM "$server" 2>/dev/null
  wait "$server" 2>/dev/null
  server=""
}

trap 'stop_server; exit 0' TERM INT

while :; do
  build=$(readlink "$graph/current" 2>/dev/null || true)
  if [ "$build" != "$serving" ]; then
    stop_server
    if [ -n "$build" ]; then
      echo "follow-current: serving $build" >&2
      LBUG_FILE="$build/graph.lbdb" "$@" &
      server=$!
    else
      echo "follow-current: no build published yet in $graph; waiting" >&2
    fi
    serving=$build
  elif [ -n "$server" ] && ! kill -0 "$server" 2>/dev/null; then
    wait "$server"
    status=$?
    echo "follow-current: the server exited with status $status" >&2
    exit "$status"
  fi
  # In the background, so a TERM is handled at once rather than after the sleep.
  sleep "$interval" &
  wait $!
done
